#include <behaviors.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

&nice_view_spi {
        cs-gpios = <&pro_micro 8 GPIO_ACTIVE_HIGH>;
};

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        display-name = "Base";

// -----------------------------------------------------------------------------------------
// | ESC |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
// | TAB |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
// | CTRL |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ALT  |
//                    | SHFT | LWR | SPC |   | ENT | RSE  | SHFT |
                        bindings = <
   &kp ESC   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
   &kp TAB &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
   &kp LCTRL &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp RALT
                  &kp LSHFT &mo 1 &kp SPACE   &kp RET &mo 2 &kp RSHIFT
                        >;
                };
                lower_layer {
                        display-name = "Lower";
// -----------------------------------------------------------------------------------------
// | ESC |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
// | TAB | BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     | LGUI  |
// | F1 | F2 | F3 | F4 | F5      | F6  |   | F7  | F8  |  F9 | F10 | F11 |  F12 |
//                    | SHIFT |     | SPC |   | ENT |     | SHIFT |
                        bindings = <
   &kp ESC    &kp N1       &kp N2       &kp N3       &kp N4       &kp N5         &kp N6   &kp N7   &kp N8 &kp N9    &kp N0 &kp BSPC
//   &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans
   &kp TAB &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &kp LGUI
   &kp F1  &kp F2       &kp F3       &kp F4       &kp F5       &kp F6         &kp F7   &kp F8   &kp F9 &kp F10    &kp F11 &kp F12
                                    &kp LSHFT      &trans       &kp SPACE      &kp RET  &trans   &kp RSHIFT 
                        >;
                };

                raise_layer {
                        display-name = "Raise";
// -----------------------------------------------------------------------------------------
// | ESC |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | DEL |
// | TAB |     |     |     |     |     |   |  [  |  ]  |  \  |     |     |  `   |
// | CTRL |     |     |     |     |    |   |  -  |  =  |     |     |     |      |
//                    | LSHIFT |     | SPC |   | ENT |     | RSHIFT |
                        bindings = <
   &kp  ESC  &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &kp DEL
   &kp TAB &trans   &trans &trans   &trans   &trans      &kp LBKT &kp RBKT &kp BACKSLASH  &trans &trans &kp GRAVE
   &kp LCTRL &trans   &trans &trans   &trans   &trans      &kp MINUS    &kp EQUAL    &trans    &trans    &trans   &kp TILDE
                             &kp LSHFT  &trans   &kp SPACE   &kp RET   &trans    &kp RSHIFT
                        >;
                };
        };
};
